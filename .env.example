# Copy to .env and fill in. `.env` is gitignored — never commit secrets.

# ── API keys ──────────────────────────────────────────────────────────────────
# Your Cesto API key (cesto_sk_…). Read examples work with any key;
# open/close/bridge examples need a WRITE-scoped key.
CESTO_API_KEY=

# ── Wallets ───────────────────────────────────────────────────────────────────
# Solana wallet address. BYOW read examples (03, 04) query it; the BYOW
# solana→base bridge signs with it. Both BYOW bridge examples verify the key
# derives this address.
WALLET_ADDRESS=
# Secret key of a wallet YOU control, funded with the input token. Open/close gas is
# sponsored — SOL is only needed for the Solana→Base bridge burn (~0.005 SOL).
# Accepts a base58 string (Phantom export) or a JSON byte array (solana-keygen).
WALLET_SECRET_KEY=
# EVM (Base) wallet: the BYOW base→solana bridge and managed:fund sign with it;
# solana→base bridges and the managed withdrawal receive to it. In the managed
# track this is the user's only wallet.
EVM_WALLET_ADDRESS=
EVM_USER_PRIVATE_KEY=

# ── Products (byow 02, 04–07; managed open/close) ─────────────────────────────
# Basket to use in the product/position/open/close examples.
PRODUCT_SLUG=stable-genius
# Amount to invest on open, in input-token base units (e.g. 5 USDC = 5000000).
OPEN_AMOUNT_BASE_UNITS=5000000

# ── Bridge (byow 09/10, managed fund/withdraw) ────────────────────────────────
# USDC base units per run (default 1000000 = 1 USDC).
BRIDGE_AMOUNT_BASE_UNITS=1000000
# 'fast' (~seconds, ~1bps fee) or 'standard' (lossless, slower from EVM).
BRIDGE_MODE=fast
# RPC endpoints — optional; sane public defaults are built into the code.
SOLANA_RPC_URL=
BASE_RPC_URL=
