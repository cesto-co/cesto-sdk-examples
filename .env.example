# Copy to .env and fill in. `.env` is gitignored — never commit secrets.

# ── API keys ──────────────────────────────────────────────────────────────────
# Your Cesto API key (cesto_sk_…). Read examples work with any key;
# open/close/bridge examples need a WRITE-scoped key.
CESTO_API_KEY=

# ── Wallets ───────────────────────────────────────────────────────────────────
# Solana wallet address. Read examples (03, 04) query it; bridge 10 signs with
# it, and both bridge examples verify the key derives this address.
WALLET_ADDRESS=
# Secret key of a wallet YOU control, funded with the input token + SOL for gas.
# Accepts a base58 string (Phantom export) or a JSON byte array (solana-keygen).
WALLET_SECRET_KEY=
# EVM (Base) wallet: bridge 09 signs with it, bridge 10 receives to it.
EVM_WALLET_ADDRESS=
EVM_USER_PRIVATE_KEY=

# ── Products (02, 04–07) ─────────────────────────────────────────────────────
# Basket to use in the product/position/open/close examples.
PRODUCT_SLUG=stable-genius
# Amount to invest on open, in input-token base units (e.g. 5 USDC = 5000000).
OPEN_AMOUNT_BASE_UNITS=5000000

# ── Bridge (09, 10) ───────────────────────────────────────────────────────────
# USDC base units per run (default 1000000 = 1 USDC).
BRIDGE_AMOUNT_BASE_UNITS=1000000
# 'fast' (~seconds, ~1bps fee) or 'standard' (lossless, slower from EVM).
BRIDGE_MODE=fast
# RPC endpoints — optional; sane public defaults are built into the code.
SOLANA_RPC_URL=
BASE_RPC_URL=
